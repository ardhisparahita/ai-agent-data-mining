# Groq (gratis) — daftar di https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding lokal (gratis, tidak butuh API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

ECOMMERCE_API_BASE_URL=http://localhost:3000/api/v1
ECOMMERCE_API_TOKEN=replace_with_valid_jwt_token

CHROMA_PERSIST_DIR=./chroma_db
AI_SERVICE_PORT=8000